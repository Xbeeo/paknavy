<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_credit_sale_report_wizard_form" model="ir.ui.view">
        <field name="name">credit.sale.report.wizard.form</field>
        <field name="model">credit.sale.report.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group>
                        <field name="pos_config_ids" widget="many2many_tags"/>
                    </group>
                </group>
                <footer>
                    <button name="action_print" type="object"
                            string="Print" class="btn-primary"/>
                    <button name="action_print_excel" type="object" string="Print Excel" class="btn-secondary"/>
                    <button string="Cancel" special="cancel"/>

                </footer>
            </form>
        </field>
    </record>

    <record id="action_credit_sale_report_wizard" model="ir.actions.act_window">
        <field name="name">Credit Sale Report</field>
        <field name="res_model">credit.sale.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_credit_sale_report"
              name="Credit Sale Report"
              parent="point_of_sale.menu_point_rep"
              action="action_credit_sale_report_wizard"
              sequence="50"/>

</odoo>