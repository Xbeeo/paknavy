<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_barcode_report_wizard_form" model="ir.ui.view">
        <field name="name">barcode.report.wizard.form</field>
        <field name="model">barcode.report.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group>
                        <field name="pos_config_ids" widget="many2many_tags"/>
                    </group>
                </group>
                <footer>
                    <button name="action_print" type="object"
                            string="Print Excel" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_barcode_report_wizard" model="ir.actions.act_window">
        <field name="name">Barcode Report</field>
        <field name="res_model">barcode.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_barcode_report"
              name="Barcode Report"
              parent="point_of_sale.menu_point_rep"
              action="action_barcode_report_wizard"
              sequence="51"/>

</odoo>