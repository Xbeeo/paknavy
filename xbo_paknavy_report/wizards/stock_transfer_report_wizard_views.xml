<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="stock_transfer_report_wizard_form" model="ir.ui.view">
        <field name="name">stock.transfer.report.wizard.form</field>
        <field name="model">stock.transfer.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Stock Transfer Report">
                <group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group>
                        <field name="location_id" options="{'no_create': True}"/>
                        <field name="partner_id" options="{'no_create': True}"/>
                    </group>
                </group>
                <footer>
                    <button name="action_print_excel" string="Print Excel" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="stock_transfer_report_wizard_action" model="ir.actions.act_window">
        <field name="name">Stock Transfer Report</field>
        <field name="res_model">stock.transfer.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_stock_transfer_report"
              name="Stock Transfer Report"
              parent="stock.menu_warehouse_report"
              action="stock_transfer_report_wizard_action"
              groups="stock.group_stock_user"
              sequence="90"/>
</odoo>